ENV=development
ADDR=:3080

# Base URL used only by the CLI to print full check-in URLs (e.g. in
# `deadman add` / `deadman url`). The server itself doesn't need it.
PUBLIC_URL=https://deadman.example.com

# File paths for the services config and heartbeat state.
# Defaults if unset: ~/.config/deadman/services.csv and ~/.local/deadman/state.json
#CONFIG_PATH=./services.csv
#STATE_PATH=./state.json

# SMTP, required by `deadman serve`.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=deadman@example.com
